# ---- Service ----
ENVIRONMENT=dev
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,https://skillswap.asia

# ---- Database (Postgres RIÊNG của AI service, có pgvector) ----
DATABASE_URL=postgresql+asyncpg://skillswap_ai:change-me@ai-postgres:5432/skillswap_ai

# ---- FPT AI Factory ----
FPT_API_KEY=
FPT_BASE_URL=https://mkp-api.fptcloud.com/v1
MODEL_CLASSIFY=gpt-oss-20b
MODEL_CHAT=DeepSeek-V4-Flash
MODEL_TOOLS=gpt-oss-120b
MODEL_EMBEDDING=Vietnamese_Embedding
MODEL_RERANK=bge-reranker-v2-m3
EMBEDDING_DIM=1024

# Hạn mức FPT (mặc định 50 req/phút, 100k token/phút cho mỗi model)
RATE_LIMIT_RPM=50
RATE_LIMIT_TPM=100000

# ---- Ngân sách (VND) ----
DAILY_BUDGET_VND=25000
USD_TO_VND=26300

# ---- Auth: verify JWT do BE cấp ----
# HS256: điền JWT_SECRET_KEY (base64, giống hệt BE)
# RS256: điền JWT_PUBLIC_KEY (PEM) và đổi JWT_ALGORITHM
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=
JWT_AUDIENCE=

# ---- Backend SkillSwap ----
BACKEND_URL=http://spring-backend:8080
# Token tài khoản service "SkillSwap AI" (role AI_BOT, TamVQ cấp).
# Cũng dùng làm token nội bộ cho BE gọi /v1/moderate và /v1/forum/* (header X-Internal-Token).
BOT_ACCESS_TOKEN=

# ---- Forum bot ----
FORUM_BOT_ENABLED=false
FORUM_BOT_POLL_ENABLED=false        # chỉ bật khi BE chưa bắn event ForumPostCreated
FORUM_BOT_POLL_SECONDS=300
FORUM_GRACE_MINUTES=15              # chờ người thật trả lời trước
FORUM_MAX_REPLIES_PER_HOUR=6
FORUM_BOT_USER_ID=                  # userId của tài khoản bot, để bot không trả lời bài của chính nó
FUNNEL_EVENTS_ENABLED=false         # bật khi BE thêm MentorFunnelSource.AI_*

# ---- Chat ----
CHAT_RATE_LIMIT_PER_HOUR=20
CHAT_MAX_HISTORY=20

# ---- Object storage (S3-compatible, bucket RIÊNG của AI) ----
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=skillswap-ai-docs
S3_ACCESS_KEY=
S3_SECRET_KEY=
